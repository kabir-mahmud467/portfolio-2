<%- include('../partials/header', { user: user }) %>

<section class="contact-page">
  <div class="contact-hero glass-card">
    <p class="eyebrow">Contact</p>
    <h2>Let&apos;s build something thoughtful together.</h2>
    <p class="contact-intro">
      Whether it is a new site, a redesign, or a product that needs a careful technical hand, I&apos;m happy to hear about it.
      Send a quick note and I&apos;ll get back with next steps.
    </p>
    <div class="contact-quick-links">
      <a class="secondary-button" href="mailto:hello@kabirmahmud.xyz">Email me</a>
      <a class="secondary-button" href="/projects/">See projects</a>
    </div>
  </div>

  <div class="contact-layout">
    <div class="contact-info-stack">
      <article class="contact-info-card">
        <div class="contact-icon" aria-hidden="true">✉</div>
        <div class="contact-details">
          <h3>Email</h3>
          <p>hello@kabirmahmud.xyz</p>
        </div>
      </article>
      <article class="contact-info-card">
        <div class="contact-icon" aria-hidden="true">⌂</div>
        <div class="contact-details">
          <h3>Based in</h3>
          <p>Bangladesh, working remotely worldwide</p>
        </div>
      </article>
      <article class="contact-info-card">
        <div class="contact-icon" aria-hidden="true">⚡</div>
        <div class="contact-details">
          <h3>Typical reply</h3>
          <p>Within 1 to 2 business days</p>
        </div>
      </article>
    </div>

    <div class="contact-form-card glass-card">
      <h3>Send a message</h3>
      <form class="contact-form" method="post" action="/contact">
        <div class="form-group">
          <label for="contact-name">Name</label>
          <input id="contact-name" name="name" class="form-control" type="text" required placeholder="Your name">
        </div>
        <div class="form-group">
          <label for="contact-email">Email</label>
          <input id="contact-email" name="email" class="form-control" type="email" required placeholder="you@example.com">
        </div>
        <div class="form-group">
          <label for="contact-subject">Subject</label>
          <input id="contact-subject" name="subject" class="form-control" type="text" placeholder="How can I help?">
        </div>
        <div class="form-group">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="message" class="form-control contact-message" required placeholder="Tell me a little about your idea, timeline, or goals."></textarea>
        </div>
        <button type="submit" class="btn">Send message</button>
      </form>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
