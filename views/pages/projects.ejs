<%- include('../partials/header', { user: user }) %>

<section>
  <h2>Projects</h2>
  <div class="projects-grid">
    <% items.forEach(p => { %>
      <article class="glass-card">
        <h3><%= p.title %></h3>
        <p><%= p.description %></p>
        <% if (p.image) { %>
          <img src="<%= p.image %>" alt="<%= p.title %>" style="max-width:100%; border-radius: 14px; margin-top: 1rem;">
        <% } %>
      </article>
    <% }) %>
  </div>
  <% if (total && limit) { %>
    <nav>
      <% const pages = Math.ceil(total/limit) %>
      <% for (let i=1;i<=pages;i++) { %>
        <a href="/projects/?page=<%= i %>&limit=<%= limit %>"><%= i %></a>
      <% } %>
    </nav>
  <% } %>
</section>

<%- include('../partials/footer') %>
