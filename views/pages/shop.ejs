<%- include('../partials/header', { user: user }) %>

<section>
  <h2>Shop</h2>
  <div class="projects-grid">
    <% items.forEach(item => { %>
      <article class="glass-card">
        <% if (item.image) { %>
          <img src="<%= item.image %>" alt="<%= item.title %>" style="max-width:100%; border-radius: 14px; margin-bottom: 1rem;">
        <% } %>
        <h3><%= item.title %></h3>
        <p><%= item.description %></p>
        <p style="margin-top: 1rem; color: #cbd5e1;"><strong>$<%= item.price || 0 %></strong><% if (item.category) { %> · <%= item.category %><% } %></p>
      </article>
    <% }) %>
  </div>
  <% if (total && limit) { %>
    <nav>
      <% const pages = Math.ceil(total / limit) %>
      <% for (let i = 1; i <= pages; i++) { %>
        <a href="/shop/?page=<%= i %>&limit=<%= limit %>"><%= i %></a>
      <% } %>
    </nav>
  <% } %>
</section>

<%- include('../partials/footer') %>
