<%- include('../partials/header', { user: user }) %>

<section>
  <h2>Social</h2>
  <div class="social-grid">
    <% items.forEach(s => { %>
      <div class="social-stack">
        <article class="social-item">
          <% if (s.image) { %>
            <img src="<%= s.image %>" alt="<%= s.platform %>">
          <% } %>
          <h4><%= s.platform %></h4>
        </article>
        <a class="social-profile-link" href="<%= s.url %>" target="_blank" rel="noreferrer">View profile</a>
      </div>
    <% }) %>
  </div>
</section>

<%- include('../partials/footer') %>
