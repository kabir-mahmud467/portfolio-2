<%- include('../partials/header', { user: user }) %>

<section>
  <h2>Resources</h2>
  <div class="projects-grid">
    <% items.forEach(r => { %>
      <article class="glass-card">
        <% if (r.image) { %>
          <img src="<%= r.image %>" alt="<%= r.title %>" style="max-width:100%; border-radius: 14px; margin-bottom: 1rem;">
        <% } %>
        <a href="<%= r.link %>"><%= r.title %></a>
        <p><%= r.description %></p>
        <p style="margin-top: 1rem; color: #cbd5e1;"><strong><%= formatDollar(r.price) %></strong></p>
        <div class="content-actions">
          <a href="<%= buyUrl %>" class="buy-button">Buy</a>
          <% if (r.pdf) { %>
            <a href="<%= r.pdf %>" class="secondary-button" target="_blank" rel="noreferrer">Open PDF</a>
          <% } %>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<%- include('../partials/footer') %>
