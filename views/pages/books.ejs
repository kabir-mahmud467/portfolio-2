<%- include('../partials/header', { user: user }) %>

<section>
  <h2>Books</h2>
  <div class="projects-grid">
    <% items.forEach(item => { %>
      <% const purchased = Array.isArray(purchasedBooks) && purchasedBooks.includes(String(item._id)) %>
      <article class="glass-card">
        <% if (item.image) { %>
          <img src="<%= item.image %>" alt="<%= item.title %>" style="max-width:100%; border-radius: 14px; margin-bottom: 1rem;">
        <% } %>
        <h3><%= item.title %></h3>
        <% if (item.author) { %>
          <p style="color: #94a3b8; margin-bottom: 0.75rem;"><%= item.author %></p>
        <% } %>
        <p><%= item.description %></p>
        <p style="margin-top: 1rem; color: #cbd5e1;"><strong><%= formatDollar(item.price) %></strong></p>
        <div class="content-actions">
          <form method="post" action="/books/<%= item.slug %>/buy" style="display:inline;">
            <button type="submit" class="buy-button">Buy</button>
          </form>
          <% if (purchased) { %>
            <a href="/books/<%= item.slug %>/" class="secondary-button">View</a>
          <% } else { %>
            <a href="#" class="secondary-button is-disabled" aria-disabled="true" tabindex="-1">View</a>
          <% } %>
        </div>
      </article>
    <% }) %>
  </div>
  <% if (total && limit) { %>
    <nav>
      <% const pages = Math.ceil(total / limit) %>
      <% for (let i = 1; i <= pages; i++) { %>
        <a href="/books/?page=<%= i %>&limit=<%= limit %>"><%= i %></a>
      <% } %>
    </nav>
  <% } %>
</section>

<%- include('../partials/footer') %>
