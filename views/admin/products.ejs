<%- include('../partials/adminHeader') %>

<section>
  <div class="admin-section-head">
    <div>
      <p class="admin-kicker">Shop</p>
      <h2>Merchandise catalog</h2>
    </div>
    <a class="admin-action" href="/admin/products/new">New Shop Item</a>
  </div>
  <div class="admin-card-grid">
    <% items.forEach(item => { %>
      <article class="admin-card">
        <% if (item.image) { %>
          <img class="admin-card-media" src="<%= item.image %>" alt="<%= item.title %>">
        <% } %>
        <div class="admin-card-body">
          <h3><%= item.title %></h3>
          <p><%= item.category || 'Uncategorized' %></p>
          <p class="admin-price"><%= formatDollar(item.price) %></p>
        </div>
        <div class="admin-card-actions">
          <a href="/admin/products/<%= item._id %>/edit">Edit</a>
          <form method="post" action="/admin/products/<%= item._id %>/delete" style="display:inline" onsubmit="return confirm('Delete this product?')">
            <button type="submit">Delete</button>
          </form>
        </div>
      </article>
    <% }) %>
  </div>
  <% if (total && limit) { %>
    <div class="admin-pagination">Page <%= page %> of <%= Math.ceil(total/limit) %></div>
  <% } %>
</section>

<%- include('../partials/adminFooter') %>
