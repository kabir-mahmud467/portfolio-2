<%- include('../partials/adminHeader') %>

<section>
  <h2>New Book</h2>
  <form method="post" action="/admin/books" enctype="multipart/form-data">
    <div><label>Title<input name="title" required /></label></div>
    <div><label>Author<input name="author" /></label></div>
    <div><label>Price<input name="price" type="number" step="0.01" /></label></div>
    <div><label>Image File<input type="file" name="image" accept="image/*" /></label></div>
    <div><label>Image URL<input name="imageUrl" type="url" placeholder="https://example.com/image.jpg" /></label></div>
    <button type="submit">Create</button>
  </form>
</section>

<%- include('../partials/adminFooter') %>
