<%- include('../partials/adminHeader') %>

<section>
  <div class="admin-section-head">
    <div>
      <p class="admin-kicker">Books</p>
      <h2>New Book</h2>
    </div>
    <a class="admin-secondary" href="/admin/books">Back to list</a>
  </div>
  <form class="admin-form-grid" method="post" action="/admin/books" enctype="multipart/form-data">
    <div class="admin-field"><label>Title<input name="title" required placeholder="Book title" /></label></div>
    <div class="admin-field"><label>Author<input name="author" placeholder="Author name" /></label></div>
    <div class="admin-field"><label>Price<input name="price" type="number" step="0.01" placeholder="0.00" /></label></div>
    <div class="admin-field">
      <label>Image File<input type="file" name="image" accept="image/*" /></label>
      <p class="admin-field-hint">Book cover image or a pasted URL below.</p>
    </div>
    <div class="admin-field"><label>Image URL<input name="imageUrl" type="url" placeholder="https://example.com/image.jpg" /></label></div>
    <div class="admin-field">
      <label>PDF File<input type="file" name="pdf" accept="application/pdf" /></label>
      <p class="admin-field-hint">Upload the book PDF or paste a PDF URL below.</p>
    </div>
    <div class="admin-field"><label>PDF URL<input name="pdfUrl" type="url" placeholder="https://example.com/book.pdf" /></label></div>
    <button type="submit">Create</button>
  </form>
</section>

<%- include('../partials/adminFooter') %>
