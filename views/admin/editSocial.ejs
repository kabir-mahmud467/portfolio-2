<%- include('../partials/adminHeader') %>

<section>
  <div class="admin-section-head">
    <div>
      <p class="admin-kicker">Social Links</p>
      <h2>Edit Social Link</h2>
    </div>
    <a class="admin-secondary" href="/admin/socials">Back to list</a>
  </div>
  <form class="admin-form-grid" method="post" action="/admin/socials/<%= item._id %>" enctype="multipart/form-data">
    <div class="admin-field"><label>Platform<input name="platform" value="<%= item.platform %>" required /></label></div>
    <div class="admin-field"><label>URL<input name="url" type="url" value="<%= item.url %>" required /></label></div>
    <div class="admin-field"><label>Icon<input name="icon" value="<%= item.icon || '' %>" placeholder="fa-brands fa-github" /></label></div>
    <% if (item.image) { %>
      <div class="admin-upload-preview admin-social-preview">
        <p class="admin-field-hint">Current image</p>
        <img src="<%= item.image %>" alt="<%= item.platform %>">
      </div>
    <% } %>
    <div class="admin-field"><label>Image File<input type="file" name="image" accept="image/*" /></label></div>
    <div class="admin-field"><label>Image URL<input name="imageUrl" type="url" value="<%= item.image || '' %>" placeholder="https://example.com/image.jpg" /></label></div>
    <button type="submit">Save</button>
  </form>
</section>

<%- include('../partials/adminFooter') %>
