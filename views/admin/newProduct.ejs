<%- include('../partials/adminHeader') %>

<section>
  <div class="admin-section-head">
    <div>
      <p class="admin-kicker">Shop</p>
      <h2>New Shop Item</h2>
    </div>
    <a class="admin-secondary" href="/admin/products">Back to list</a>
  </div>
  <form class="admin-form-grid" method="post" action="/admin/products" enctype="multipart/form-data">
    <div class="admin-field"><label>Title<input name="title" required placeholder="Product title" /></label></div>
    <div class="admin-field"><label>Description<textarea name="description" placeholder="Short product description"></textarea></label></div>
    <div class="admin-field"><label>Category<input name="category" placeholder="Category" /></label></div>
    <div class="admin-field"><label>Price<input name="price" type="number" step="0.01" placeholder="0.00" /></label></div>
    <div class="admin-field">
      <label>Image File<input type="file" name="image" accept="image/*" /></label>
      <p class="admin-field-hint">Use an uploaded product image or paste a URL.</p>
    </div>
    <div class="admin-field"><label>Image URL<input name="imageUrl" type="url" placeholder="https://example.com/image.jpg" /></label></div>
    <button type="submit">Create</button>
  </form>
</section>

<%- include('../partials/adminFooter') %>
