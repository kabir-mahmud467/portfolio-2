<%- include('../partials/adminHeader') %>

<section>
  <div class="admin-section-head">
    <div>
      <p class="admin-kicker">Resources</p>
      <h2>Useful links and assets</h2>
    </div>
    <a class="admin-action" href="/admin/resources/new">New Resource</a>
  </div>
  <div class="admin-card-grid">
    <% items.forEach(item => { %>
      <article class="admin-card">
        <% if (item.image) { %>
          <img class="admin-card-media" src="<%= item.image %>" alt="<%= item.title %>">
        <% } %>
        <div class="admin-card-body">
          <h3><%= item.title %></h3>
          <p><%= item.description || 'No description provided.' %></p>
          <p class="admin-price"><%= formatDollar(item.price) %></p>
          <% if (item.link) { %>
            <a class="admin-link" href="<%= item.link %>" target="_blank" rel="noreferrer">Open link</a>
          <% } %>
        </div>
        <div class="admin-card-actions">
          <a href="/admin/resources/<%= item._id %>/edit">Edit</a>
          <form method="post" action="/admin/resources/<%= item._id %>/delete" style="display:inline" onsubmit="return confirm('Delete this resource?')">
            <button type="submit">Delete</button>
          </form>
        </div>
      </article>
    <% }) %>
  </div>
  <% if (total && limit) { %>
    <div class="admin-pagination">Page <%= page %> of <%= Math.ceil(total/limit) %></div>
  <% } %>
</section>

<%- include('../partials/adminFooter') %>
