<%- include('../partials/adminHeader') %>

<section>
  <div class="admin-section-head">
    <div>
      <p class="admin-kicker">Projects</p>
      <h2>Edit Project</h2>
    </div>
    <a class="admin-secondary" href="/admin/projects">Back to list</a>
  </div>
  <form class="admin-form-grid" method="post" action="/admin/projects/<%= item._id %>" enctype="multipart/form-data">
    <div class="admin-field"><label>Title<input name="title" value="<%= item.title %>" required /></label></div>
    <div class="admin-field"><label>Description<textarea name="description"><%= item.description %></textarea></label></div>
    <div class="admin-field"><label>Link<input name="link" type="url" value="<%= item.link %>" /></label></div>
    <% if (item.image) { %>
      <div class="admin-upload-preview">
        <p class="admin-field-hint">Current image</p>
        <img src="<%= item.image %>" alt="<%= item.title %>" style="max-width: 260px; border-radius: 14px; border: 1px solid rgba(255,255,255,0.12);">
      </div>
    <% } %>
    <div class="admin-field"><label>Image File<input type="file" name="image" accept="image/*" /></label></div>
    <div class="admin-field"><label>Image URL<input name="imageUrl" type="url" value="<%= item.image || '' %>" placeholder="https://example.com/image.jpg" /></label></div>
    <button type="submit">Save</button>
  </form>
</section>

<%- include('../partials/adminFooter') %>
