<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/src/admin.css">
</head>
<body class="admin-body">
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <div class="admin-brand">
        <div class="admin-mark">KM</div>
        <div>
          <strong>Kabir Mahmud</strong>
          <span>Content Studio</span>
        </div>
      </div>

      <nav class="admin-nav">
        <a href="/admin/">Dashboard</a>
        <a href="/admin/projects">Projects</a>
        <a href="/admin/blogs">Blogs</a>
        <a href="/admin/products">Shop</a>
        <a href="/admin/books">Books</a>
        <a href="/admin/resources">Resources</a>
        <a href="/admin/socials">Social Links</a>
        <a href="/admin/contacts">Contacts</a>
      </nav>

      <div class="admin-sidebar-footer admin-mobile-footer">
        <a href="/auth/logout" class="admin-mobile-logout">Log out</a>
      </div>

    </aside>

    <button class="admin-backdrop" type="button" aria-label="Close admin menu" aria-hidden="true" tabindex="-1"></button>

    <div class="admin-main">
      <header class="admin-topbar">
        <div class="admin-topbar-copy">
          <p class="admin-kicker">Portfolio CMS</p>
          <h1>Content control room</h1>
          <p class="admin-topbar-subtitle">Manage every portfolio asset from one polished workspace.</p>
        </div>
        <div class="admin-topbar-meta">
          <button class="admin-menu-toggle" type="button" aria-label="Toggle admin menu" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
          </button>
          <a href="/auth/logout" class="admin-desktop-logout">Log out</a>
          <div class="admin-status">Live</div>
          <div class="admin-user-chip">
            <span class="admin-user-dot"></span>
            <span><%= (typeof user !== 'undefined' && user && user.username) ? user.username : 'Admin' %></span>
          </div>
        </div>
      </header>
      <main class="admin-content">
